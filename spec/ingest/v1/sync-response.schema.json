{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wrygloss:ingest:v1:sync-response:1.0",
  "title": "Wrygloss ingest v1.0: sync response (200)",
  "description": "Il server MUST produrre risposte conformi; l'agente ignora i campi che non conosce.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "server_time", "missing", "rejected", "deleted", "min_interval_s", "latest_agent"],
  "properties": {
    "schema": { "const": "1.0" },
    "server_time": { "type": "string" },
    "missing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotations", "words", "books"],
      "properties": {
        "annotations": { "type": "array", "items": { "type": "string" } },
        "words": { "type": "array", "items": { "type": "string" } },
        "books": { "type": "array", "items": { "type": "string" } }
      }
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "id", "code"],
        "properties": {
          "kind": { "enum": ["annotations", "words", "books"] },
          "id": { "type": "string" },
          "code": { "enum": ["id_too_long", "field_too_long", "invalid_value"] },
          "pointer": { "type": "string" }
        }
      }
    },
    "deleted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotations", "words", "books"],
      "properties": {
        "annotations": { "type": "integer", "minimum": 0 },
        "words": { "type": "integer", "minimum": 0 },
        "books": { "type": "integer", "minimum": 0 }
      }
    },
    "min_interval_s": { "type": "integer", "minimum": 0 },
    "latest_agent": { "type": ["string", "null"] }
  }
}
