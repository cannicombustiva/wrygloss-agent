{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wrygloss:ingest:v1:sync-request:1.0",
  "title": "Wrygloss ingest v1.0: sync request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run", "device", "upserts"],
  "properties": {
    "schema": { "const": "1.0" },
    "run": { "$ref": "#/$defs/run" },
    "device": { "$ref": "#/$defs/device" },
    "upserts": { "$ref": "#/$defs/upserts" },
    "manifest": { "$ref": "#/$defs/manifest" }
  },
  "if": { "properties": { "run": { "properties": { "final": { "const": true } } } } },
  "then": { "required": ["manifest"] },
  "else": { "not": { "required": ["manifest"] } },
  "$defs": {
    "h": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "id": { "type": "string", "minLength": 1 },
    "str": { "type": ["string", "null"] },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "agent_version", "started_at", "route_at_event", "route_ready_ms", "attempt", "batch", "final", "warnings"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
        "agent_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$", "maxLength": 32 },
        "started_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$" },
        "route_at_event": { "type": "boolean" },
        "route_ready_ms": { "type": ["integer", "null"], "minimum": 0 },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 100 },
        "batch": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "final": { "type": "boolean" },
        "warnings": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "pattern": "^[a-z_]{1,40}(:[A-Za-z0-9_.-]{1,80})?$" }
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firmware", "model_id", "arch"],
      "properties": {
        "firmware": { "type": ["string", "null"], "maxLength": 32 },
        "model_id": { "type": ["string", "null"], "maxLength": 64 },
        "arch": { "type": "string", "maxLength": 16 }
      }
    },
    "upserts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotations", "words", "books"],
      "properties": {
        "annotations": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/annotation" } },
        "words": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/word" } },
        "books": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/book" } }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "h", "volume_id", "content_id", "chapter_title", "type", "text", "annotation", "start_path", "end_path", "chapter_progress", "color", "hidden", "created", "modified"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "h": { "$ref": "#/$defs/h" },
        "volume_id": { "$ref": "#/$defs/str" },
        "content_id": { "$ref": "#/$defs/str" },
        "chapter_title": { "$ref": "#/$defs/str" },
        "type": { "$ref": "#/$defs/str" },
        "text": { "$ref": "#/$defs/str" },
        "annotation": { "$ref": "#/$defs/str" },
        "start_path": { "$ref": "#/$defs/str" },
        "end_path": { "$ref": "#/$defs/str" },
        "chapter_progress": { "type": ["number", "null"] },
        "color": { "type": ["integer", "null"] },
        "hidden": { "type": ["boolean", "null"] },
        "created": { "$ref": "#/$defs/str" },
        "modified": { "$ref": "#/$defs/str" }
      }
    },
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "h", "volume_id", "dict_suffix", "created"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "h": { "$ref": "#/$defs/h" },
        "volume_id": { "$ref": "#/$defs/str" },
        "dict_suffix": { "$ref": "#/$defs/str" },
        "created": { "$ref": "#/$defs/str" }
      }
    },
    "book": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "h", "title", "author", "language", "position"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "h": { "$ref": "#/$defs/h" },
        "title": { "$ref": "#/$defs/str" },
        "author": { "$ref": "#/$defs/str" },
        "language": { "$ref": "#/$defs/str" },
        "position": { "$ref": "#/$defs/str" }
      }
    },
    "kindManifest": {
      "type": "object",
      "maxProperties": 50000,
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/h" }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotations": { "$ref": "#/$defs/kindManifest" },
        "words": { "$ref": "#/$defs/kindManifest" },
        "books": { "$ref": "#/$defs/kindManifest" }
      }
    }
  }
}
