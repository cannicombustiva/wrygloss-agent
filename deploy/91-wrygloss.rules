# Wrygloss: on every wlan0 activation, run run.sh from the user partition (it starts the agent in the background).
# If the .adds/wrygloss folder is deleted the rule does nothing harmful: sh does not find the script and exits.
ACTION=="add", SUBSYSTEM=="net", KERNEL=="wlan0", RUN+="/bin/sh /mnt/onboard/.adds/wrygloss/run.sh"
