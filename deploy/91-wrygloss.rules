# Wrygloss: a ogni attivazione di wlan0 lancia run.sh dalla partizione utente (che avvia l'agente in background).
# Se la cartella .adds/wrygloss viene cancellata la regola non fa nulla di dannoso: sh non trova lo script ed esce.
ACTION=="add", SUBSYSTEM=="net", KERNEL=="wlan0", RUN+="/bin/sh /mnt/onboard/.adds/wrygloss/run.sh"
